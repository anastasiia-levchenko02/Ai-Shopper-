{
  "name": "silpo-personal-shopper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Personal Shopper for Silpo — agent that turns budget + cuisine + dietary constraints into recipes and a ready-to-checkout cart via the official Silpo MCP.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "surprise": "tsx src/jobs/surprise.ts",
    "smoke": "cross-env SILPO_MODE=mock tsx src/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.4",
    "@types/node": "^24.7.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
