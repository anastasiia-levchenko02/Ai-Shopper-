# --- Silpo MCP ---
# mock  = використовувати вбудовані відповіді у форматі МСР (працює без акаунта «Сільпо»)
# live  = справжнє підключення до https://mcp.silpo.ua/mcp через OAuth 2.1 + PKCE
SILPO_MODE=mock
SILPO_MCP_URL=https://mcp.silpo.ua/mcp

# --- Agent brain ---
# off = меню планується з вбудованої бібліотеки (детерміновано, без LLM)
# on  = меню й заміни генерує Claude API (потрібен ключ нижче)
SILPO_LLM=off
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server ---
PORT=5173
# Куди повертає OAuth після логіну в акаунт «Сільпо» (лише для SILPO_MODE=live)
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
